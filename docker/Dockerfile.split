ARG BASE_IMAGE=medha-all-in-one:latest
FROM ${BASE_IMAGE}

COPY docker/supervisor/worker.conf /etc/supervisor/worker.conf
COPY docker/supervisor/storage.conf /etc/supervisor/storage.conf
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/dev.conf /etc/nginx/conf.d/dev.conf
COPY docker/nginx/prod.conf /etc/nginx/conf.d/prod.conf
COPY docker/scripts/role-entrypoint.sh /opt/medha/scripts/role-entrypoint.sh
COPY docker/scripts/init-postgres.sh /opt/medha/scripts/init-postgres.sh
COPY docker/scripts/run-backend-dev.sh /opt/medha/scripts/run-backend-dev.sh
COPY docker/scripts/run-backend-prod.sh /opt/medha/scripts/run-backend-prod.sh
COPY docker/scripts/backup.sh /opt/medha/scripts/backup.sh
COPY docker/scripts/healthcheck.sh /opt/medha/scripts/healthcheck.sh

RUN chmod 0755 /opt/medha/scripts/*.sh

HEALTHCHECK --interval=20s --timeout=8s --start-period=30s --retries=3 \
  CMD ["/opt/medha/scripts/healthcheck.sh"]

ENTRYPOINT ["/opt/medha/scripts/role-entrypoint.sh"]
